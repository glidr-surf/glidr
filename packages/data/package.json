{
  "name": "@glidr/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "./scripts/setup.sh",
    "db:push": "supabase db push --workdir .",
    "db:seed": "supabase db seed --workdir .",
    "db:reset": "supabase db reset --workdir ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0"
  },
  "devDependencies": {
    "typescript": "^5.8",
    "vitest": "^4.1.8"
  }
}
