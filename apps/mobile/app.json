{
  "expo": {
    "name": "Glidr",
    "slug": "glidr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "glidr",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-wordmark.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8432A"
    },
    "ios": {
      "bundleIdentifier": "surf.glidr.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "surf.glidr.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8432A"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Glidr needs access to your photos so you can add a photo of your board.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b8d3596-36f3-4c97-8013-26919140e55e"
      }
    },
    "owner": "nud3l"
  }
}
